{
  "name": "@prism/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prism HTTP 服务（零框架 node:http）+ stdio MCP：知识库 / 代码图谱 / 任务台账 / Studio 静态托管",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.testcheck.json --noEmit"
  },
  "dependencies": {
    "@prism/agents": "workspace:*",
    "@prism/core": "workspace:*",
    "@prism/knowledge": "workspace:*",
    "@prism/skills": "workspace:*"
  }
}
